MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_MS=30000
PORT=3001

# 方言语音识别（OpenAI 兼容 /audio/transcriptions 接口，可用 FunASR 自部署或讯飞、腾讯云）
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

# 可选：大模型语义安全第二层，默认关闭；打开后规则过滤通过的内容会再交给模型审核一次
SAFETY_MODEL_ENABLED=false
SAFETY_MODEL_NAME=
SAFETY_MODEL_TIMEOUT_MS=8000
